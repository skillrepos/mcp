{
    "image": "ghcr.io/skillrepos/mcp-devcontainer:latest",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "forwardPorts": [
        8000
    ],
    "portsAttributes": {
        "8000": {
            "label": "MCP Server",
            "visibility": "public"
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.terminal.activateEnvInCurrentTerminal": true,
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/py_env/bin/python",
                "github.copilot.enable": {
                    "*": false,
                    "plaintext": false,
                    "markdown": false,
                    "scminput": false
                },
                "workbench.startupEditor": "none",
                "mergeInfo.skeletonHighlights": true,
                "mergeInfo.reviewHighlights": true,
                "workbench.editorAssociations": {
                    "*.md": "vscode.markdown.preview.editor"
                }
            },
            "extensions": [
                "mathematic.vscode-pdf"
            ]
        }
    },
    "postCreateCommand": "bash -i scripts/pysetup.sh py_env && bash -i scripts/startOllama.sh",
    "postStartCommand": "bash scripts/serveOllama.sh",
    "postAttachCommand": {
        "merge-info": "nohup bash -c 'for i in 1 2 3 4 5 6; do code --install-extension ${containerWorkspaceFolder}/.devcontainer/merge-info-0.3.1.vsix --force && break; sleep 10; done' >/tmp/merge-info-install.log 2>&1 &"
    }
}
